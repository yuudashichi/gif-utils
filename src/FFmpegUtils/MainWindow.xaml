<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:FFmpegUtils.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FFmpegUtils.MainWindow" Title="GIF Utils" Icon="Assets/AppIcon.ico" Width="1120" Height="800" MinWidth="760" MinHeight="540" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource ModernInputBox}">
                <EventSetter Event="PreviewMouseWheel" Handler="ScrollableControl_PreviewMouseWheel" />
            </Style>
            <Style x:Key="SelectBox" TargetType="ComboBox" BasedOn="{StaticResource ModernSelectBox}">
                <EventSetter Event="PreviewMouseWheel" Handler="ScrollableControl_PreviewMouseWheel" />
            </Style>
            <Style x:Key="MetadataValue" TargetType="TextBox" BasedOn="{StaticResource ModernMetadataValue}">
                <EventSetter Event="PreviewMouseWheel" Handler="ScrollableControl_PreviewMouseWheel" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <Path Data="M0,0 L0,16 L13,8 Z" Fill="{DynamicResource OnAccentBrush}" Width="13" Height="16" Stretch="Uniform" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="GIF Utils" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="轻巧的多媒体工作空间" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EngineStatus}" ToolTip="{Binding EngineVersion}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="设置" Click="OpenSettings_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="打开应用设置" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12" x:Name="TaskFooter">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ImageInfoStatusText" Text="{Binding ImageInfo.Status}" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" Visibility="{Binding IsSelected, ElementName=ImageInfoTab, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.LiveSetting="Polite" />
                    <Grid HorizontalAlignment="Stretch" Margin="0,0,24,0" Visibility="{Binding IsSelected, ElementName=GifTab, Converter={StaticResource BooleanToVisibility}}" ToolTip="{Binding GifDetail}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding GifStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="2" Value="{Binding GifProgress, Mode=OneWay}" Maximum="100" Height="7" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBrush}" />
                        <TextBlock Grid.Column="4" Text="{Binding GifProgress, StringFormat={}{0:0}%}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding GifDetail}" ToolTip="{Binding GifDetail}" Visibility="{Binding IsSelected, ElementName=GifTab, Converter={StaticResource BooleanToVisibility}}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,24,0" TextTrimming="CharacterEllipsis" />
                    <Grid HorizontalAlignment="Stretch" Margin="0,0,24,0" Visibility="{Binding IsSelected, ElementName=SubtitleTab, Converter={StaticResource BooleanToVisibility}}" ToolTip="{Binding SubtitleDetail}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SubtitleStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="2" Value="{Binding SubtitleProgress, Mode=OneWay}" Maximum="100" Height="7" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBrush}" />
                        <TextBlock Grid.Column="4" Text="{Binding SubtitleProgress, StringFormat={}{0:0}%}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding SubtitleDetail}" ToolTip="{Binding SubtitleDetail}" Visibility="{Binding IsSelected, ElementName=SubtitleTab, Converter={StaticResource BooleanToVisibility}}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,24,0" TextTrimming="CharacterEllipsis" />
                    <Grid HorizontalAlignment="Stretch" Margin="0,0,24,0" Visibility="{Binding IsSelected, ElementName=XDownloadTab, Converter={StaticResource BooleanToVisibility}}" ToolTip="{Binding XDownloadDetail}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding XDownloadStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="2" Value="{Binding XDownloadProgress, Mode=OneWay}" Maximum="100" Height="7" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBrush}" />
                        <TextBlock Grid.Column="4" Text="{Binding XDownloadProgress, StringFormat={}{0:0}%}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding XDownloadDetail}" ToolTip="{Binding XDownloadDetail}" Visibility="{Binding IsSelected, ElementName=XDownloadTab, Converter={StaticResource BooleanToVisibility}}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,24,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsSelected, ElementName=GifTab, Converter={StaticResource BooleanToVisibility}}">
                        <Button Content="打开结果" Tag="{Binding LastGifOutputPath}" Click="OpenResult_Click" Margin="0,0,8,0" AutomationProperties.Name="打开已完成的输出文件">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GifStatus}" Value="转换完成">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="CancelGif_Click" IsEnabled="{Binding IsGifRunning}" AutomationProperties.Name="取消 GIF 转换" />
                        <Button Content="导出 GIF" Style="{StaticResource PrimaryButton}" Click="StartGif_Click" IsEnabled="{Binding IsGifReady}" AutomationProperties.Name="开始 MP4 转 GIF" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsSelected, ElementName=SubtitleTab, Converter={StaticResource BooleanToVisibility}}">
                        <Button Content="打开结果" Tag="{Binding LastSubtitleOutputPath}" Click="OpenResult_Click" Margin="0,0,8,0" AutomationProperties.Name="打开已完成的输出文件">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SubtitleStatus}" Value="烧录完成">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="CancelSubtitle_Click" IsEnabled="{Binding IsSubtitleRunning}" AutomationProperties.Name="取消字幕烧录" />
                        <Button Content="开始烧录" Style="{StaticResource PrimaryButton}" Click="StartSubtitle_Click" IsEnabled="{Binding IsSubtitleReady}" AutomationProperties.Name="开始烧录字幕" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsSelected, ElementName=XDownloadTab, Converter={StaticResource BooleanToVisibility}}">
                        <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="CancelXDownload_Click" IsEnabled="{Binding IsXBusy}" AutomationProperties.Name="取消 X 链接解析或下载" />
                        <Button Content="开始下载" Style="{StaticResource PrimaryButton}" Click="StartXDownload_Click" IsEnabled="{Binding IsXDownloadReady}" AutomationProperties.Name="开始下载所选 X 媒体" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" TabStripPlacement="Left">
            <TabItem x:Name="GifTab" Header="MP4 转 GIF" Tag="M2,2 H18 V18 H2 Z M7,6 L14,10 L7,14 Z">
                <ScrollViewer x:Name="GifScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Foreground="{DynamicResource TextBrush}" FontWeight="Normal">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="MP4 转 GIF" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="GifEngineErrorText" Text="{Binding EngineError}" Style="{StaticResource EngineErrorText}" />
                        <Grid x:Name="GifWorkspace">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource SectionCard}" AllowDrop="True" DragOver="File_DragOver" Drop="GifInput_Drop" x:Name="GifPreviewCard" Margin="0,0,16,16" VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="源视频" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding GifMediaSummary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding GifInputPath, Mode=OneWay}" Style="{StaticResource InputBox}" IsReadOnly="True" AutomationProperties.Name="所选 MP4 文件" />
                                        <Button Grid.Column="1" Content="选择文件" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="BrowseGifInput_Click" IsEnabled="{Binding CanChangeGifSource}" AutomationProperties.Name="选择 MP4 文件" />
                                    </Grid>
                                    <Expander x:Name="GifTrimExpander" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" IsExpanded="True" Margin="0,10,0,0">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="预览与截取" VerticalAlignment="Center" />
                                                <Control Style="{StaticResource HelpBadge}" ToolTip="拖动左右外侧小手柄调整起止时间，靠近播放指针时自动吸附；缩略图与下方播放条只改变播放位置。左右键定位，Shift+左右键调起点，Ctrl+左右键调终点，每次 0.05 秒。播放只限选区，收起后暂停。开始或结束留空表示视频开头或结尾。" AutomationProperties.Name="截取时间说明" AutomationProperties.HelpText="说明 GIF 开始和结束截取时间" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <controls:GifTrimEditor x:Name="GifTrimPanel" DataContext="{Binding GifTrim}" />
                                    </Expander>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}" x:Name="GifSettingsCard" Grid.Column="1" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="导出设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Style="{StaticResource FieldHeader}">
                                                <TextBlock Text="压缩模式" Style="{StaticResource HelpFieldLabel}" />
                                                <Control Style="{StaticResource HelpBadge}" ToolTip="选择一组预设参数。高清画质最好但体积较大；均衡适合大多数情况；小体积和极小会降低分辨率、帧率及颜色；指定目标大小会自动多轮压缩；自定义保留你填写的参数。" AutomationProperties.Name="压缩模式说明" AutomationProperties.HelpText="说明 GIF 压缩模式预设的区别" />
                                            </StackPanel>
                                            <ComboBox ItemsSource="{Binding GifPresetNames}" SelectedItem="{Binding SelectedGifPreset}" Style="{StaticResource SelectBox}" AutomationProperties.Name="GIF 压缩模式" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <StackPanel Style="{StaticResource FieldHeader}">
                                                <TextBlock Text="目标上限（MB）" Style="{StaticResource HelpFieldLabel}" />
                                                <Control Style="{StaticResource HelpBadge}" ToolTip="希望 GIF 不超过的文件大小，仅在“指定目标大小”模式下生效。GIF 大小无法提前精确预测，程序最多尝试 4 轮压缩；如果最低质量仍然超过目标，会保留结果并提示。" AutomationProperties.Name="目标大小说明" AutomationProperties.HelpText="说明 GIF 目标文件大小上限" />
                                            </StackPanel>
                                            <TextBox Text="{Binding GifTargetSizeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" IsEnabled="{Binding IsTargetSizeMode}" AutomationProperties.Name="GIF 目标大小 MB" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,8,0,12">
                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap">
                                            <Run Text="{Binding GifMaxWidth, Mode=OneWay}" />
                                            <Run Text=" px  ·  " />
                                            <Run Text="{Binding GifFrameRate, Mode=OneWay}" />
                                            <Run Text=" FPS  ·  " />
                                            <Run Text="{Binding GifColors, Mode=OneWay}" />
                                            <Run Text=" 色" />
                                        </TextBlock>
                                    </Border>
                                    <Expander x:Name="GifAdvancedExpander" Header="高级参数" FontWeight="Normal" Foreground="{DynamicResource TextBrush}">
                                        <UniformGrid Columns="2" Margin="0,12,0,8">
                                            <StackPanel Margin="0,0,8,12">
                                                <StackPanel Style="{StaticResource FieldHeader}">
                                                    <TextBlock Text="最大宽度" Style="{StaticResource HelpFieldLabel}" />
                                                    <Control Style="{StaticResource HelpBadge}" ToolTip="输出 GIF 的最大像素宽度。程序不会放大比它更小的源视频。宽度越小，像素总量越少，文件通常会明显变小；常用值为 360、480、720。" AutomationProperties.Name="最大宽度说明" AutomationProperties.HelpText="说明 GIF 最大像素宽度" />
                                                </StackPanel>
                                                <TextBox Text="{Binding GifMaxWidth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" PreviewTextInput="IntegerInput_PreviewTextInput" DataObject.Pasting="IntegerInput_Pasting" AutomationProperties.Name="GIF 最大宽度" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,12">
                                                <StackPanel Style="{StaticResource FieldHeader}">
                                                    <TextBlock Text="帧率 FPS" Style="{StaticResource HelpFieldLabel}" />
                                                    <Control Style="{StaticResource HelpBadge}" ToolTip="每秒显示多少张画面。数值越高越流畅，但帧数和文件体积也越大。多数 GIF 使用 10–15 FPS 已较流畅，动作较快时可用 20 FPS。" AutomationProperties.Name="帧率说明" AutomationProperties.HelpText="说明 GIF 每秒帧数" />
                                                </StackPanel>
                                                <TextBox Text="{Binding GifFrameRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" PreviewTextInput="IntegerInput_PreviewTextInput" DataObject.Pasting="IntegerInput_Pasting" AutomationProperties.Name="GIF 帧率" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,12">
                                                <StackPanel Style="{StaticResource FieldHeader}">
                                                    <TextBlock Text="颜色数量" Style="{StaticResource HelpFieldLabel}" />
                                                    <Control Style="{StaticResource HelpBadge}" ToolTip="GIF 调色板最多可使用 256 种颜色。颜色越多，渐变和照片越自然，但文件通常更大；128–256 适合普通视频，64–128 适合界面录屏或小体积输出。" AutomationProperties.Name="颜色数量说明" AutomationProperties.HelpText="说明 GIF 调色板颜色数量" />
                                                </StackPanel>
                                                <TextBox Text="{Binding GifColors, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" PreviewTextInput="IntegerInput_PreviewTextInput" DataObject.Pasting="IntegerInput_Pasting" AutomationProperties.Name="GIF 颜色数量" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,12">
                                                <StackPanel Style="{StaticResource FieldHeader}">
                                                    <TextBlock Text="颜色抖动" Style="{StaticResource HelpFieldLabel}" />
                                                    <Control Style="{StaticResource HelpBadge}" ToolTip="用像素纹理模拟调色板中没有的颜色。平滑适合照片和渐变，视觉最好；规整通常更利于压缩，适合录屏；无抖动体积可能更小，但容易出现明显色带。" AutomationProperties.Name="颜色抖动说明" AutomationProperties.HelpText="说明 GIF 颜色抖动方式" />
                                                </StackPanel>
                                                <ComboBox ItemsSource="{Binding DitherOptions}" SelectedItem="{Binding SelectedDither}" Style="{StaticResource SelectBox}" AutomationProperties.Name="GIF 抖动方式" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </Expander>
                                    <TextBlock Text="GIF 保存位置" Margin="0,4,0,2" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding GifOutputPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" AutomationProperties.Name="GIF 保存位置" />
                                        <Button Grid.Column="1" Content="选择位置" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="BrowseGifOutput_Click" AutomationProperties.Name="选择 GIF 保存位置" />
                                    </Grid>
                                    <TextBlock Text="目标体积模式最多尝试 4 轮；实际大小以导出结果为准。" Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding GifError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Style="{StaticResource MetadataMessage}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="SubtitleTab" Header="字幕烧录" Tag="M2,3 H18 V17 H2 Z M5,10 H15 M5,14 H11">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Foreground="{DynamicResource TextBrush}" FontWeight="Normal">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="字幕烧录" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="SubtitleEngineErrorText" Text="{Binding EngineError}" Style="{StaticResource EngineErrorText}" />
                        <Border Style="{StaticResource SectionCard}" AllowDrop="True" DragOver="File_DragOver" Drop="SubtitleVideo_Drop">
                            <StackPanel>
                                <TextBlock Text="视频与字幕" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="视频文件" />
                                    <TextBlock Grid.Column="1" Text="{Binding SubtitleMediaSummary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SubtitleVideoPath, Mode=OneWay}" Style="{StaticResource InputBox}" IsReadOnly="True" />
                                    <Button Grid.Column="1" Content="选择视频" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="BrowseSubtitleVideo_Click" AutomationProperties.Name="选择需要烧录字幕的视频" />
                                </Grid>
                                <TextBlock Text="字幕文件" Margin="0,4,0,2" />
                                <Grid AllowDrop="True" DragOver="File_DragOver" Drop="SubtitleFile_Drop">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SubtitleFilePath, Mode=OneWay}" Style="{StaticResource InputBox}" IsReadOnly="True" />
                                    <Button Grid.Column="1" Content="选择字幕" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="BrowseSubtitleFile_Click" AutomationProperties.Name="选择字幕文件" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="输出设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="保存位置" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SubtitleOutputPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                                        <Button Grid.Column="1" Content="选择" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="BrowseSubtitleOutput_Click" />
                                    </Grid>
                                </StackPanel>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,12,0">
                                        <StackPanel Style="{StaticResource FieldHeader}">
                                            <TextBlock Text="编码方式" Style="{StaticResource HelpFieldLabel}" />
                                            <Control Style="{StaticResource HelpBadge}" ToolTip="自动会依次实际检测 NVIDIA NVENC、Intel QSV 和 AMD AMF，均不可用时回退到 CPU。手动指定 GPU 时，如编码器或显卡不可用会直接提示。GPU 通常更快，但同一质量数值与 CPU 的画质并非完全等价。" AutomationProperties.Name="视频编码方式说明" AutomationProperties.HelpText="说明 CPU 与 GPU 视频编码方式" />
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding SubtitleVideoEncoderOptions}" SelectedItem="{Binding SelectedSubtitleVideoEncoder}" ToolTip="{Binding SelectedSubtitleVideoEncoder}" Style="{StaticResource SelectBox}" AutomationProperties.Name="字幕烧录编码方式" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <StackPanel Style="{StaticResource FieldHeader}">
                                            <TextBlock Text="字幕编码" Style="{StaticResource HelpFieldLabel}" />
                                            <Control Style="{StaticResource HelpBadge}" ToolTip="决定如何读取字幕文件中的文字。自动会优先识别 UTF-8，无法识别时尝试 GB18030；如果烧录后中文乱码，可手动切换为 UTF-8 或 GB18030。" AutomationProperties.Name="字幕编码说明" AutomationProperties.HelpText="说明字幕文本编码" />
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding SubtitleEncodingOptions}" SelectedItem="{Binding SelectedSubtitleEncoding}" Style="{StaticResource SelectBox}" AutomationProperties.Name="字幕文件编码" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <StackPanel Style="{StaticResource FieldHeader}">
                                            <TextBlock Text="视频质量" Style="{StaticResource HelpFieldLabel}" />
                                            <Control Style="{StaticResource HelpBadge}" ToolTip="范围 16–30，越低画质越高、文件越大。CPU 使用 CRF，GPU 会映射为对应编码器的质量参数；推荐 18–23，默认 20。" AutomationProperties.Name="视频质量说明" AutomationProperties.HelpText="说明字幕烧录视频质量数值" />
                                        </StackPanel>
                                        <TextBox Text="{Binding SubtitleCrf, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" PreviewTextInput="IntegerInput_PreviewTextInput" DataObject.Pasting="IntegerInput_Pasting" AutomationProperties.Name="字幕烧录视频质量" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding SubtitleError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Style="{StaticResource MetadataMessage}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="XDownloadTab" Header="X 下载" Tag="M10,1 V13 M5,8 L10,13 L15,8 M2,14 V19 H18 V14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Foreground="{DynamicResource TextBrush}" FontWeight="Normal">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="X 视频下载" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="XEngineErrorText" Text="{Binding EngineError}" Style="{StaticResource EngineErrorText}" />
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="X 帖子链接" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding XUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" ToolTip="支持 x.com、twitter.com 及 t.co 的公开帖子链接" AutomationProperties.Name="X 帖子链接" />
                                    <Button Grid.Column="1" Content="粘贴" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" MinWidth="58" Click="PasteXUrl_Click" AutomationProperties.Name="从剪贴板粘贴 X 链接" />
                                    <Button Grid.Column="2" Content="解析链接" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Click="ParseXUrl_Click" IsEnabled="{Binding CanParseXUrl}" AutomationProperties.Name="解析 X 帖子媒体" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="150" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="媒体与画质" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding XMediaSummary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="8,2,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Content="全选" IsChecked="{Binding SelectAllXMedia, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="选择全部 X 媒体" />
                                </Grid>
                                <Grid Grid.Row="2">
                                    <ListBox ItemsSource="{Binding XMediaItems}" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="解析到的 X 媒体列表">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="8,10" />
                                                <Setter Property="IsTabStop" Value="False" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="ItemSurface" Background="Transparent" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="285" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="选择此媒体" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="3" ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality, Mode=TwoWay}" Style="{StaticResource SelectBox}" VerticalAlignment="Center" AutomationProperties.Name="下载画质">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="解析后，媒体会显示在这里" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="Wrap" Margin="16">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasXMedia}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.3*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="保存目录" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding XOutputDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" AutomationProperties.Name="X 视频保存目录" />
                                        <Button Grid.Column="1" Content="选择" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="BrowseXOutputDirectory_Click" AutomationProperties.Name="选择 X 视频保存目录" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <StackPanel Style="{StaticResource FieldHeader}">
                                        <TextBlock Text="文件名前缀" Style="{StaticResource HelpFieldLabel}" />
                                        <Control Style="{StaticResource HelpBadge}" ToolTip="留空时使用 X_用户名_帖子ID。下载多个媒体会自动添加序号；若文件已存在，会再添加不重复的后缀。" AutomationProperties.Name="X 下载文件名前缀说明" />
                                    </StackPanel>
                                    <TextBox Text="{Binding XFilePrefix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" AutomationProperties.Name="X 下载文件名前缀" />
                                </StackPanel>
                                <Button Grid.Column="3" Content="打开文件夹" Style="{StaticResource SecondaryButton}" Margin="8,17,0,0" VerticalAlignment="Top" Click="OpenXOutputDirectory_Click" IsEnabled="{Binding HasXDownloadResult}" AutomationProperties.Name="打开 X 视频保存文件夹" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding XResultSummary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="2,0,2,2" ToolTip="{Binding XResultSummary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding XResultSummary}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding XWarning}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Style="{StaticResource MetadataMessage}" />
                        <TextBlock Text="{Binding XError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Style="{StaticResource MetadataMessage}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ImageInfoTab" Header="图片信息" Tag="M1,2 H19 V18 H1 Z M2,16 L7,10 L11,14 L14,9 L19,15 M5,6 H7">
                <ScrollViewer x:Name="ImageInfoScrollViewer" DataContext="{Binding ImageInfo}" FontWeight="Normal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowDrop="True" PreviewDragOver="ImageInfo_DragOver" Drop="ImageInfo_Drop" Foreground="{DynamicResource TextBrush}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="图片信息" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                        <Border Style="{StaticResource MetadataSection}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding InputPath, Mode=OneWay}" Style="{StaticResource InputBox}" IsReadOnly="True" ToolTip="选择或拖入一张本地图片" AutomationProperties.Name="所选图片路径" />
                                <Button Grid.Column="1" Content="选择图片" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="BrowseImageInfo_Click" IsEnabled="{Binding CanSelect}" AutomationProperties.Name="选择图片并读取信息" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Error}" Style="{StaticResource MetadataMessage}" Foreground="{DynamicResource ErrorBrush}" />
                        <TextBlock Text="{Binding Details.Warning}" Style="{StaticResource MetadataMessage}" Foreground="{DynamicResource MutedTextBrush}" />
                        <Grid x:Name="ImageWorkspace">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource MetadataSection}" Margin="0,0,16,16" x:Name="ImagePreviewCard" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="图片预览" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <Grid Height="280" Background="{DynamicResource BackgroundBrush}">
                                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" AutomationProperties.Name="本地图片预览" />
                                        <TextBlock Text="{Binding PreviewMessage}" TextWrapping="Wrap" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                                    </Grid>
                                    <TextBlock Text="图片与拍摄信息在本机读取。地址查询仅在你确认后联网。" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="ImageDetailsPanel" Grid.Column="1">
                                <Border x:Name="ImageDimensionsSection" Style="{StaticResource MetadataSection}">
                                    <StackPanel>
                                        <TextBlock Text="图片尺寸" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Details.Dimensions}" ItemTemplate="{StaticResource MetadataFieldTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ImageShootingSection" Style="{StaticResource MetadataSection}">
                                    <StackPanel>
                                        <TextBlock Text="拍摄信息" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Details.Shooting}" ItemTemplate="{StaticResource MetadataFieldTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ImageLocationSection" Style="{StaticResource MetadataSection}" Margin="0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="地理位置" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button x:Name="ResolveImageAddressButton" DockPanel.Dock="Right" Content="{Binding AddressActionText}" Style="{StaticResource SecondaryButton}" Click="ResolveImageAddress_Click" IsEnabled="{Binding CanResolve}" ToolTip="手动联网查询；发送经纬度，不上传图片。查询中可点击取消。" AutomationProperties.Name="解析图片 GPS 地址或取消查询" />
                                            <TextBlock Text="{Binding AddressStatus}" ToolTip="{Binding AddressStatusToolTip}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.LiveSetting="Polite" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Details.Location}" ItemTemplate="{StaticResource MetadataFieldTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="城市/区县" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding Region, Mode=OneWay}" Style="{StaticResource MetadataValue}" ToolTip="{Binding Region}" AutomationProperties.Name="城市与区县（地图匹配）" />
                                            <TextBlock Grid.Row="1" Text="附近地址" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NearbyAddress, Mode=OneWay}" Style="{StaticResource MetadataValue}" ToolTip="{Binding NearbyAddress}" AutomationProperties.Name="附近街道或地标（非精确拍摄地址）" />
                                        </Grid>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" ToolTip="{Binding AddressDetail}">
                                    地图：Photon · <Hyperlink Click="OpenMapAttribution_Click" Foreground="{DynamicResource FocusBrush}">© OpenStreetMap 贡献者</Hyperlink>
                                    · 附近地址不代表准确拍摄地点
                                </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="SettingsTab" Header="设置" Tag="M3,4 H17 M3,10 H17 M3,16 H17 M7,1 V7 M13,7 V13 M7,13 V19">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Foreground="{DynamicResource TextBrush}" FontWeight="Normal">
                    <StackPanel>
                        <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20" />
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="主题" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ThemeSelector" Style="{StaticResource SelectBox}" Width="220" HorizontalAlignment="Left" SelectionChanged="ThemeSelector_SelectionChanged" AutomationProperties.Name="应用主题">
                                    <ComboBoxItem Content="跟随系统" />
                                    <ComboBoxItem Content="浅色" />
                                    <ComboBoxItem Content="深色" />
                                </ComboBox>
                                <TextBlock x:Name="ThemeSaveStatus" Style="{StaticResource MetadataMessage}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="媒体处理引擎" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="FFmpeg 用于转换、预览和合并视频。请选择 ffmpeg.exe，其同目录需有 ffprobe.exe。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,16" />
                                <TextBlock Text="{Binding EngineStatus}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding EnginePath}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding EngineVersion}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,12" />
                                <Button x:Name="SelectEngineButton" Content="选择 FFmpeg" Click="SelectFfmpeg_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" IsEnabled="{Binding CanChangeGifSource}" />
                                <TextBlock Text="{Binding EngineError}" Style="{StaticResource EngineErrorText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
